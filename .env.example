# Copy to .env and fill in real values. Never commit .env.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk Dashboard webhook endpoint (needs the ngrok/tunnel URL + /api/webhooks/clerk first)
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon Postgres connection string (pooled)
DATABASE_URL=

# Primary AI provider. From https://platform.openai.com/api-keys (API usage is billed separately from ChatGPT)
OPENAI_API_KEY=
# Fallback AI provider, used when OpenAI fails. From https://aistudio.google.com/apikey (free tier available)
GOOGLE_GENAI_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 1 = use the local Inngest Dev Server (no event/signing key needed). Unset/production build = real Inngest.
INNGEST_DEV=1

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
